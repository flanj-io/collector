    },
    {
      "name": "input-type-narrowed (union loses a member)",
      "before": { "tools": [ { "name": "list_transactions", "inputSchema": { "type": "object", "properties": { "limit": { "type": ["integer", "string"] } } } } ] },
      "after": { "tools": [ { "name": "list_transactions", "inputSchema": { "type": "object", "properties": { "limit": { "type": "integer" } } } } ] },
      "expect": [ { "class": "BREAKING", "operationId": "list_transactions", "rule": "input-type-changed", "fieldPath": "input.limit" } ]
    },
    {
