      "after": { "tools": [ { "name": "create_refund", "inputSchema": { "type": "object" }, "outputSchema": { "type": "object", "properties": { "status": { "type": "string", "enum": ["pending", "succeeded", "requires_action"] } } } } ] },
      "expect": [ { "class": "NON_BREAKING", "operationId": "create_refund", "rule": "output-enum-value-added", "fieldPath": "output.status" } ]
