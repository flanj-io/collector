      "after": { "tools": [ { "name": "refund_create", "description": "Create a refund.", "inputSchema": { "type": "object", "properties": { "charge_id": { "type": "string" }, "amount": { "type": "integer" } }, "required": ["charge_id", "amount"] } } ] },
      "expect": [ { "class": "BREAKING", "operationId": "create_refund", "rule": "operation-renamed", "fieldPath": "", "before": "create_refund", "after": "refund_create" } ]
    },
    {
      "name": "operation-renamed with co-occurring output type change (both must surface)",
      "before": { "tools": [ { "name": "create_refund", "description": "Create a refund.", "inputSchema": { "type": "object", "properties": { "charge_id": { "type": "string" }, "amount": { "type": "integer" } }, "required": ["charge_id", "amount"] }, "outputSchema": { "type": "object", "properties": { "amount": { "type": "number" } }, "required": ["amount"] } } ] },
      "after": { "tools": [ { "name": "refund_create", "description": "Create a refund.", "inputSchema": { "type": "object", "properties": { "charge_id": { "type": "string" }, "amount": { "type": "integer" } }, "required": ["charge_id", "amount"] }, "outputSchema": { "type": "object", "properties": { "amount": { "type": "string" } }, "required": ["amount"] } } ] },
      "expect": [
        { "class": "BREAKING", "operationId": "create_refund", "rule": "operation-renamed", "fieldPath": "", "before": "create_refund", "after": "refund_create" },
        { "class": "BREAKING", "operationId": "refund_create", "rule": "output-property-type-changed", "fieldPath": "output.amount" }
      ]
    },
