{
  "_comment": "Step A definition-diff classifier battery (v0.5 spec §4.A acceptance (2)): >=2 cases per class (BREAKING / NON_BREAKING / DESCRIPTION), including a rename — plus the rename edge cases: a rename with a co-occurring output change must yield BOTH changes, and a schema-less/empty-object pair must never pair as a rename (the deliberate strengthening documented in contract/diff's package comment). Each case diffs two tools/list revisions (the classifier is transport-neutral; contract/diff/diff_test.go also replays one case through the OpenAPI loader). COLLECTOR-OWNED for now; promote to the canonical e2e/contracts set when another repo consumes it.",
  "cases": [
    {
      "name": "no-change",
      "before": { "tools": [ { "name": "get_balance", "description": "Get the current balance.", "inputSchema": { "type": "object", "properties": { "account_id": { "type": "string" } }, "required": ["account_id"] }, "outputSchema": { "type": "object", "properties": { "amount": { "type": "number" } }, "required": ["amount"] } } ] },
      "after": { "tools": [ { "name": "get_balance", "description": "Get the current balance.", "inputSchema": { "type": "object", "properties": { "account_id": { "type": "string" } }, "required": ["account_id"] }, "outputSchema": { "type": "object", "properties": { "amount": { "type": "number" } }, "required": ["amount"] } } ] },
      "expect": []
    },
    {
      "name": "operation-removed",
      "before": { "tools": [ { "name": "get_balance", "inputSchema": { "type": "object", "properties": { "account_id": { "type": "string" } } } }, { "name": "create_refund", "inputSchema": { "type": "object", "properties": { "charge_id": { "type": "string" } } } } ] },
      "after": { "tools": [ { "name": "get_balance", "inputSchema": { "type": "object", "properties": { "account_id": { "type": "string" } } } } ] },
      "expect": [ { "class": "BREAKING", "operationId": "create_refund", "rule": "operation-removed", "fieldPath": "" } ]
    },
