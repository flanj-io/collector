      "name": "input-property-removed",
      "before": { "tools": [ { "name": "create_refund", "inputSchema": { "type": "object", "properties": { "charge_id": { "type": "string" }, "reason": { "type": "string" } }, "required": ["charge_id"] } } ] },
      "after": { "tools": [ { "name": "create_refund", "inputSchema": { "type": "object", "properties": { "charge_id": { "type": "string" } }, "required": ["charge_id"] } } ] },
      "expect": [ { "class": "BREAKING", "operationId": "create_refund", "rule": "input-property-removed", "fieldPath": "input.reason" } ]
