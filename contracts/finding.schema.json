{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flanj.io/contracts/v1/finding.schema.json",
  "title": "Finding",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version", "id", "kind", "severity", "integration",
    "endpoint", "expected", "actual", "rule", "detected_at"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "id": { "type": "string", "format": "uuid" },
    "kind": { "type": "string", "enum": ["live-vs-spec", "version-diff", "output_mismatch", "definition_change", "stale_client"] },
    "change_kind": { "description": "R-A (Idan, 2026-09-17): WHAT moved — a FINER axis than `kind`, which names which detector spoke. Additive and OPTIONAL: set on MCP findings only (definition_change carries wording|input|output|catalog, output_mismatch carries value, stale_client carries observed_failure); absent on the HTTP/OpenAPI kinds and on findings from older collectors, so readers must tolerate its absence. A kind never implies a severity.", "type": "string", "enum": ["wording", "input", "output", "catalog", "value", "observed_failure"] },
    "severity": { "type": "string", "enum": ["breaking", "warning", "info"] },
    "integration": { "type": "string" },
    "endpoint": { "type": "string" },
    "field_path": { "type": ["string", "null"] },
    "location": { "type": ["string", "null"] },
    "expected": { "type": "string" },
    "actual": { "type": "string" },
    "rule": { "type": "string" },
    "spec_version_from": { "type": ["string", "null"] },
    "spec_version_to": { "type": ["string", "null"] },
    "source_call_id": { "type": ["string", "null"] },
    "detected_at": { "type": "string", "format": "date-time" },
    "detail": { "type": "string" },
    "snapshot_observed_at": { "type": "string", "format": "date-time" },
    "snapshot_observed_from": { "type": "string", "format": "date-time" }
  }
}
