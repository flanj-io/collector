# Build outputs and caches — never send to the Docker build context.
_build/
/flanj-collector
bin/
.gopath/
.gocache/
go.mod.test
**/node_modules/
ui/dist/
# The SPA is rebuilt by the node stage and embedded fresh; keep any local build
# out of the context (the placeholder index.html is restored by the build stage).
extension/flanjui/web/dist/assets/
*.db
*.db-wal
*.db-shm
*.log
.git/
# Worktrees under `.claude/worktrees/<slug>` accumulate — 1.6 GB here on 2026-09-12, each with its
# own build output and `node_modules` at a depth `**/node_modules/` does match but only after the
# daemon has already walked and transferred the tree. Excluding the root keeps the build context lean.
.claude/
.worktrees/
.env
.env.*
.DS_Store
